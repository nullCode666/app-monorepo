{
    "manifest_version": 3,
    "name": "Revault Wallet Nightly",
    "version": "0.1.0",
    "action": {
        "default_popup": "popup.html"
    },
    "options_page": "options.html",
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "fonts/*",
                "static/js/*",
                "static/css/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}